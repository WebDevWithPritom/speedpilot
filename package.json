{
  "name": "speedpilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SpeedPilot — Universal Website Performance Intelligence Platform",
  "author": "SpeedPilot Team",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@speedpilot/database",
    "db:migrate": "npm run migrate --workspace=@speedpilot/database"
  },
  "devDependencies": {
    "basic-ftp": "^6.2.6",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
