# ==============================================================================
# SpeedPilot — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security Secrets (Must be at least 32 characters in production)
SESSION_SECRET=speedpilot_super_secret_session_encryption_key_change_in_production_32chars

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://speedpilot:speedpilot_secret@localhost:5432/speedpilot?schema=public

# Queue & Cache (Redis 7+)
REDIS_URL=redis://localhost:6379

# Google Performance APIs (Optional for basic runs, recommended for production quotas)
# Obtain from Google Cloud Console with PageSpeed Insights API & CrUX API enabled
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_CRUX_API_KEY=

# Free-Tier AI Auto-Failover Waterfall (configure any 1 or more; SpeedPilot auto-rotates!)
# Tracked from github.com/cheahjs/free-llm-api-resources (official developer free tiers)
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_TOKEN=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Localhost GPU Ollama (optional for local dev / self-hosting):
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:3b

# Commercial / SaaS Features (Optional: leave blank for Community Edition)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

